// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- PESSOAS E USUÁRIOS ---

model Person {
  id           Int           @id @default(autoincrement())
  name         String
  users        User[]
  transactions Transaction[]
  debts        Debt[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   // Nome do usuário
  email     String   @unique
  password  String
  role      String   @default("USER") // ADMIN, STAFF, USER
  status    String   @default("PENDENTE") // PENDENTE, APROVADO, RECUSADO
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  logs      Log[]    // Relacionamento para Logs Obrigatórios
  createdAt DateTime @default(now())
}

// --- FINANCEIRO ---

model Transaction {
  id               Int      @id @default(autoincrement())
  description      String
  amount           Float
  date             DateTime
  card             String   // NUBANK ou MERCADO_PAGO
  isAssigned       Boolean  @default(false) // REGRA: Nenhuma transação começa atribuída
  assignedPersonId Int?
  assignedPerson   Person?  @relation(fields: [assignedPersonId], references: [id])
  createdAt        DateTime @default(now())
}

model Debt {
  id        Int       @id @default(autoincrement())
  amount    Float     // Valor original da dívida
  remaining Float     // Valor restante para Pagamento Parcial
  status    String    @default("PENDENTE") // PENDENTE, PAGO, CANCELADO
  personId  Int
  person    Person    @relation(fields: [personId], references: [id])
  payments  Payment[] // Histórico de pagamentos parciais
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float    // Valor pago no momento
  date      DateTime @default(now())
  debtId    Int
  debt      Debt     @relation(fields: [debtId], references: [id])
}

// --- SISTEMA E AUDITORIA ---

model Log {
  id        Int      @id @default(autoincrement())
  action    String   // login, logout, criação, sync, etc
  details   String   // Detalhes da ação para auditoria
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Config {
  id           Int     @id @default(1)
  webhookUrl   String? // URL do Discord
  clientId     String? // Open Finance
  clientSecret String? // Open Finance
  itemId       String? // ItemId OBRIGATÓRIO após conexão
  pixNubank    String? // Chave Pix Nubank
  pixMercado   String? // Chave Pix Mercado Pago
}
